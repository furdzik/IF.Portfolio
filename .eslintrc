{
  "parser": "@babel/eslint-parser",
  "extends": [
    "eslint-config-kamisama"
  ],
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js", ".jsx", ".json"],
        "moduleDirectory": ["node_modules", "src"]
      }
    }
  },
  "env": {
    "browser": true,
    "jest": true,
    "es6": true
  },
  "globals": {
    "NODE_ENV": "readonly",
    "JISHO_API_URL": "readonly",
    "STACKOVERFLOW_API_URL": "readonly",
    "STACKOVERFLOW_USER": "readonly",
    "GITHUB_USER": "readonly",
    "GITHUB_KEY": "readonly",
    "SENTRY_DNS": "readonly"
  }
}
