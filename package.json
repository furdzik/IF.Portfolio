{
  "name": "if.portfolio",
  "version": "1.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furdzik/if.portfolio.git"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "lint": "yarn eslint && yarn stylelint",
    "find-duplicates": "jscpd ./src/",
    "stylelint": "stylelint \"**/*.styles.{js,jsx}\"",
    "eslint": "eslint src/ --ext .jsx,.js",
    "outdated": "yarn outdated",
    "audit": "yarn audit"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@emotion/is-prop-valid": "1.2.1",
    "@emotion/react": "11.11.1",
    "@emotion/styled": "11.11.0",
    "@formatjs/intl-pluralrules": "5.2.6",
    "@formatjs/intl-relativetimeformat": "11.2.6",
    "@sentry/react": "8.33.1",
    "axios": "0.28.0",
    "caniuse-lite": "1.0.30001538",
    "core-js": "3.32.2",
    "lodash": "4.17.21",
    "prop-types": "15.8.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "5.6.0",
    "react-intl": "6.4.7",
    "react-redux": "8.1.2",
    "react-router-dom": "6.16.0",
    "redux": "4.2.1",
    "redux-thunk": "2.4.2",
    "reselect": "4.1.8",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.22.20",
    "@babel/eslint-parser": "7.22.15",
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@babel/plugin-transform-runtime": "7.22.15",
    "@babel/preset-env": "7.22.20",
    "@babel/preset-react": "7.22.15",
    "@babel/runtime": "7.22.15",
    "@commitlint/cli": "17.7.1",
    "@commitlint/config-conventional": "17.7.0",
    "@emotion/babel-plugin": "11.11.0",
    "@emotion/babel-preset-css-prop": "11.11.0",
    "commitlint": "17.7.1",
    "commitlint-config-kamisama": "0.3.3",
    "editorconfig": "1.0.4",
    "eslint": "8.50.0",
    "eslint-config-kamisama": "0.3.3",
    "husky": "8.0.3",
    "jscpd": "3.5.10",
    "postcss": "8.4.31",
    "postcss-styled-syntax": "0.5.0",
    "react-scripts": "5.0.1",
    "redux-devtools-extension": "2.13.9",
    "stylelint": "15.10.3",
    "stylelint-config-kamisama": "0.4.7"
  }
}
